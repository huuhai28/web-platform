# =============================================================================
# Biến môi trường PRODUCTION — copy thành .env.prod trên VPS rồi điền giá trị thật.
# KHÔNG commit .env.prod lên Git (đã có trong .gitignore).
#
# Tạo nhanh mật khẩu ngẫu nhiên (chỉ chữ + số, an toàn khi nằm trong URL):
#   openssl rand -hex 24
# Hoặc chạy: sh scripts/gen_prod_env.sh > .env.prod   (tự sinh toàn bộ mật khẩu)
# =============================================================================

# ---- Tên miền (bản ghi A đã trỏ về IP VPS) ----
DOMAIN=example.com
ACME_EMAIL=you@example.com            # Let's Encrypt gửi cảnh báo hết hạn chứng chỉ về đây

# ---- Database ----
POSTGRES_PASSWORD=change-me-hex        # superuser, chỉ dùng để quản trị/backup
APP_DB_PASSWORD=change-me-hex          # user "portfolio" của FastAPI/Celery
KEYCLOAK_DB_PASSWORD=change-me-hex     # user "keycloak"
REDIS_PASSWORD=change-me-hex

# ---- Keycloak ----
KEYCLOAK_ADMIN=kcadmin                 # tài khoản quản trị Keycloak (realm master)
KEYCLOAK_ADMIN_PASSWORD=change-me-long
PORTFOLIO_ADMIN_USERNAME=hai           # tài khoản đăng nhập trên website, có quyền xem tin nhắn
PORTFOLIO_ADMIN_EMAIL=you@example.com
PORTFOLIO_ADMIN_PASSWORD=change-me-min-12-chars

# ---- Email thông báo khi có người gửi form liên hệ ----
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=địa chỉ gmail,
#              SMTP_PASSWORD=App Password 16 ký tự (bật 2FA → myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=change-me
SMTP_FROM=you@gmail.com
CONTACT_RECEIVER_EMAIL=you@gmail.com

# ---- Image (dùng khi CI/CD push lên GitLab Container Registry) ----
# REGISTRY_IMAGE=registry.gitlab.com/<user>/<project>
# IMAGE_TAG=latest
