# Caddy: cổng duy nhất mở ra Internet (80/443).
# - Tự xin và tự gia hạn chứng chỉ HTTPS từ Let's Encrypt cho {$DOMAIN}.
# - Tự chuyển http → https.
# - Chặn trang quản trị Keycloak ra Internet (vào qua SSH tunnel, xem docs/DEPLOY.md).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Trang quản trị Keycloak + realm "master" (realm của admin) không được public.
	@keycloak_admin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
	respond @keycloak_admin "Not found" 404

	# Metrics/health nội bộ của Keycloak không public.
	@keycloak_internal path /auth/metrics* /auth/health*
	respond @keycloak_internal "Not found" 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	reverse_proxy frontend:80

	log {
		output stdout
		format console
	}
}

# www.example.com → example.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
