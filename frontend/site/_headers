# Header bảo mật khi host trên Cloudflare Pages (bản Docker dùng nginx/default.conf.template thay cho file này).
# Pages cộng dồn header của mọi rule khớp đường dẫn, nên CSP KHÔNG đặt ở /* mà đặt riêng cho từng trang HTML:
# trang chủ dùng CSP chặt, trang Swagger cho phép thêm style inline.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Trang chủ
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Swagger UI chèn style inline → cho phép 'unsafe-inline' cho STYLE (script vẫn chỉ 'self')
/api-docs/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800
