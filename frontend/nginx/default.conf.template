# File này là TEMPLATE: lúc container khởi động, image nginx chạy envsubst để thay ${API_UPSTREAM}
# (mặc định backend:8000, đặt trong Dockerfile) rồi ghi ra /etc/nginx/conf.d/default.conf.
# Biến nginx như $host không bị đụng tới vì chúng không phải biến môi trường.
# File nằm trong context `http` của nginx.

# ---- Request ID: giữ ID từ phía trước (Caddy/Kong) hoặc tự sinh, gắn vào log và gửi xuống backend ----
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# Access log dạng JSON một dòng → Filebeat/Logstash đưa thẳng vào Elasticsearch
log_format json_access escape=json '{"@timestamp":"$time_iso8601","service":"nginx","logger":"nginx.access",'
    '"request_id":"$req_id","client.ip":"$remote_addr","http.method":"$request_method","url.path":"$uri",'
    '"http.status_code":$status,"duration_s":$request_time,"bytes":$body_bytes_sent,'
    '"upstream.duration":"$upstream_response_time","user_agent":"$http_user_agent",'
    '"message":"$request_method $uri $status"}';
access_log /var/log/nginx/access.log json_access;

# ---- Chạy sau reverse proxy (Caddy ở production) ----
# Tin IP từ các mạng private (mạng Docker), lấy IP thật của khách từ X-Forwarded-For.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Nếu phía trước đã có proxy TLS (Caddy) thì giữ "https" mà nó gửi; chạy trực tiếp (dev) thì dùng $scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# ---- Chống spam form liên hệ: mỗi IP tối đa 5 lần POST/phút ----
map $request_method $contact_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $contact_limit_key zone=contact:10m rate=5r/m;
limit_req_status 429;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # ---- API: FastAPI backend ----
    location = /api/contact {
        limit_req zone=contact burst=3 nodelay;
        proxy_pass http://${API_UPSTREAM}/api/contact;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $req_id;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $req_id;
    }

    # ---- Keycloak (giữ header bảo mật riêng của Keycloak, không thêm CSP ở đây) ----
    # Không gửi X-Forwarded-Port: $server_port là cổng 80 *bên trong* container, khiến Keycloak
    # tạo URL thiếu cổng public (vd. localhost:3000 → localhost). Cổng đã nằm sẵn trong $http_host.
    location /auth/ {
        proxy_pass http://keycloak:8080/auth/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }

    # ---- Tài liệu API (Swagger UI): giống trang chính nhưng cho phép style inline ----
    location ^~ /api-docs/ {
        try_files $uri $uri/ =404;
        expires 1h;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }

    # ---- CSS/JS/ảnh: cache 7 ngày (đổi ?v= trong index.html khi sửa file) ----
    location ~* \.(css|js|svg|png|jpg|jpeg|webp|ico|woff2)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # ---- Trang HTML ----
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}
