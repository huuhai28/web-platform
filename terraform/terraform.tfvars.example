# Copy thành terraform.tfvars (đã có trong .gitignore) rồi sửa.
my_ip_cidr = "1.2.3.4/32" # curl -s https://checkip.amazonaws.com  → thêm /32

# true nếu muốn GitHub Actions deploy vào cluster (IP runner thay đổi liên tục)
k8s_api_public = false

# Region được phép dùng EC2 (tài khoản trong AWS Organization có thể bị SCP giới hạn region)
region               = "ap-southeast-2"
instance_type        = "c7i-flex.large" # control plane, 2 vCPU / 4 GB (free-tier-eligible)
worker_instance_type = "m7i-flex.large" # worker, 2 vCPU / 8 GB (free-tier-eligible)
worker_count         = 1

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Để trống nếu đã tạo Budget trên Console
budget_email     = ""
budget_limit_usd = 10
