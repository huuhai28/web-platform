# Copy thành terraform.tfvars (đã có trong .gitignore) rồi sửa.
my_ip_cidr = "1.2.3.4/32" # curl -s https://checkip.amazonaws.com  → thêm /32

# true nếu muốn GitHub Actions deploy vào cluster (IP runner thay đổi liên tục)
k8s_api_public = false

region        = "ap-southeast-1"
instance_type = "t3.medium"
worker_count  = 1

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Để trống nếu đã tạo Budget trên Console
budget_email     = ""
budget_limit_usd = 10
